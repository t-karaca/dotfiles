#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." >/dev/null 2>&1 && pwd)
NAVIGATOR=$ROOT_DIR/bin/fs-navigator
TMP_DIR=$(mktemp -d)
trap 'rm -rf -- "$TMP_DIR"' EXIT

fail() {
    printf 'test-navigator: %s\n' "$1" >&2
    exit 1
}

assert_file_equals() {
    local expected_file=$1
    local actual_file=$2
    local message=$3

    if ! cmp -s "$expected_file" "$actual_file"; then
        printf 'expected:\n' >&2
        od -An -tx1 "$expected_file" >&2
        printf 'actual:\n' >&2
        od -An -tx1 "$actual_file" >&2
        fail "$message"
    fi
}

root=$TMP_DIR/root
mkdir "$root" "$root/nested"
printf 'deep\n' >"$root/nested/deep.txt"
printf 'file\n' >"$root/file.txt"

fake_bin=$TMP_DIR/fake-bin
mkdir "$fake_bin"
fake_fzf=$fake_bin/fzf
fake_state=$TMP_DIR/fzf-state
printf '#!/usr/bin/env bash\nmapfile -t rows\nmapfile -t steps <"$FS_NAVIGATOR_FAKE_STATE"\nstep=${steps[0]:-cancel}\nif ((${#steps[@]} > 1)); then printf "%%s\\n" "${steps[@]:1}" >"$FS_NAVIGATOR_FAKE_STATE"; else : >"$FS_NAVIGATOR_FAKE_STATE"; fi\ncase $step in\n  enter) [[ ${#rows[@]} -gt 0 ]] || exit 1; printf "\\n%%s\\n" "${rows[0]}" ;;\n  ctrl-p|ctrl-a|ctrl-h|alt-r|alt-g) printf "%%s\\n" "$step" ;;\n  cancel) exit 130 ;;\n  *) exit 2 ;;\nesac\n' >"$fake_fzf"
chmod +x "$fake_fzf"

expected=$TMP_DIR/expected
actual=$TMP_DIR/actual

printf 'enter\nenter\n' >"$fake_state"
printf 'insert\0%s\0' "$root/nested/deep.txt" >"$expected"
PATH="$fake_bin:$PATH" FS_NAVIGATOR_FAKE_STATE="$fake_state" \
    "$NAVIGATOR" --root "$root" --cwd "$root" >"$actual"
cmp -s "$expected" "$actual" || fail 'directory Enter did not navigate before file insertion'

printf 'ctrl-p\nctrl-a\n' >"$fake_state"
printf 'cd\0%s\0' "$TMP_DIR" >"$expected"
PATH="$fake_bin:$PATH" FS_NAVIGATOR_FAKE_STATE="$fake_state" \
    "$NAVIGATOR" --root "$root" --cwd "$root" >"$actual"
cmp -s "$expected" "$actual" || fail 'parent and accept-dir actions were not preserved'

printf 'alt-r\nctrl-a\n' >"$fake_state"
printf 'cd\0%s\0' "$root/nested" >"$expected"
PATH="$fake_bin:$PATH" FS_NAVIGATOR_FAKE_STATE="$fake_state" \
    "$NAVIGATOR" --root "$root/nested" --cwd "$root" >"$actual"
cmp -s "$expected" "$actual" || fail 'root action did not restore the logical root'

printf 'alt-g\nctrl-a\n' >"$fake_state"
printf 'cd\0%s\0' "$root/nested" >"$expected"
PATH="$fake_bin:$PATH" FS_NAVIGATOR_FAKE_STATE="$fake_state" \
    "$NAVIGATOR" --root "$root" --cwd "$root" --git-root "$root/nested" >"$actual"
cmp -s "$expected" "$actual" || fail 'git-root action did not switch browse cwd'

git_project=$TMP_DIR/git-project
mkdir "$git_project" "$git_project/subdir"
git -C "$git_project" init -q
printf 'alt-g\nctrl-a\n' >"$fake_state"
printf 'cd\0%s\0' "$git_project" >"$expected"
PATH="$fake_bin:$PATH" FS_NAVIGATOR_FAKE_STATE="$fake_state" \
    "$NAVIGATOR" --cwd "$git_project/subdir" >"$actual"
cmp -s "$expected" "$actual" || fail 'Git root was not detected from the starting cwd'

printf 'cancel\n' >"$fake_state"
: >"$expected"
PATH="$fake_bin:$PATH" FS_NAVIGATOR_FAKE_STATE="$fake_state" \
    "$NAVIGATOR" --cwd "$root" >"$actual"
cmp -s "$expected" "$actual" || fail 'cancel produced an action'

module=$ROOT_DIR/zsh/fzf/filesystem.zsh
printf 'enter\nenter\n' >"$fake_state"
printf 'insert\0%s\0' "$root/nested/deep.txt" >"$expected"
(
    cd -- "$root"
    env -u TMUX PATH="$fake_bin:$PATH" FS_NAVIGATOR_FAKE_STATE="$fake_state" \
        zsh -f -c 'source "$1"; starting=$PWD; fs_navigator --root "$PWD"; [[ $PWD == $starting ]]' zsh "$module"
) >"$actual"
assert_file_equals "$expected" "$actual" 'non-tmux Zsh launcher did not return the action protocol'

fake_popup=$fake_bin/popup
printf '#!/usr/bin/env bash\nwhile [[ ${1:-} != -- ]]; do shift; done\nshift\nexec "$@"\n' >"$fake_popup"
chmod +x "$fake_popup"
printf 'enter\nenter\n' >"$fake_state"
printf 'insert\0%s\0' "$root/nested/deep.txt" >"$expected"
(
    cd -- "$root"
    PATH="$fake_bin:$PATH" FS_NAVIGATOR_FAKE_STATE="$fake_state" TMUX=1 \
        zsh -f -c 'source "$1"; FS_NAVIGATOR_POPUP="$2"; fs_navigator --root "$PWD"' zsh "$module" "$fake_popup"
) >"$actual"
assert_file_equals "$expected" "$actual" 'tmux Zsh launcher did not return the action protocol'

if "$NAVIGATOR" --cwd "$TMP_DIR/missing" >"$actual" 2>"$TMP_DIR/error"; then
    fail 'missing starting directory was accepted'
fi
[[ ! -s $actual ]] || fail 'navigator emitted an action for a provider error'
[[ $(<"$TMP_DIR/error") == *'starting directory is unavailable'* ]] || fail 'provider error was not reported'

printf 'test-navigator: PASS\n'
