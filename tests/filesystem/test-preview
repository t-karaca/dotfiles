#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." >/dev/null 2>&1 && pwd)
PREVIEW=$ROOT_DIR/bin/preview-dispatcher
TMP_DIR=$(mktemp -d)
trap 'rm -rf -- "$TMP_DIR"' EXIT

fail() {
    printf 'test-preview: %s\n' "$1" >&2
    exit 1
}

assert_contains() {
    local file=$1
    local text=$2
    [[ $(<"$file") == *"$text"* ]] || fail "missing '$text' in $file"
}

assert_not_contains() {
    local file=$1
    local text=$2
    [[ $(<"$file") != *"$text"* ]] || fail "unexpected '$text' in $file"
}

run_preview() {
    local path=$1
    local output=$2
    local error=$3
    "$PREVIEW" "$path" >"$output" 2>"$error"
}

output=$TMP_DIR/output
error=$TMP_DIR/error

directory=$TMP_DIR/directory
mkdir "$directory"
printf 'directory member\n' >"$directory/member.txt"
PREVIEW_MAX_LINES=5 run_preview "$directory" "$output" "$error"
assert_contains "$output" 'member.txt'

plain=$TMP_DIR/plain.txt
for number in {1..20}; do
    printf 'line %s\n' "$number"
done >"$plain"
PREVIEW_MAX_LINES=5 run_preview "$plain" "$output" "$error"
[[ $(wc -l <"$output") -le 10 ]] || fail 'text preview exceeded the configured line bound'

json=$TMP_DIR/data.json
printf '{"name":"phase2","ok":true}\n' >"$json"
run_preview "$json" "$output" "$error"
assert_contains "$output" 'name'

invalid_json=$TMP_DIR/invalid.json
printf 'not valid json\n' >"$invalid_json"
run_preview "$invalid_json" "$output" "$error"
assert_contains "$output" 'not valid json'

yaml=$TMP_DIR/data.yaml
printf 'name: phase2\n' >"$yaml"
run_preview "$yaml" "$output" "$error"
assert_contains "$output" 'phase2'

markdown=$TMP_DIR/readme.md
for number in {1..20}; do
    printf '# heading %s\n\nmarkdown body\n' "$number"
done >"$markdown"
run_preview "$markdown" "$output" "$error"
assert_contains "$output" 'heading 1'

binary=$TMP_DIR/data.bin
printf '\001\002\003\004' >"$binary"
run_preview "$binary" "$output" "$error"
assert_contains "$output" 'binary file'
assert_contains "$output" '01 02 03 04'

private_key=$TMP_DIR/private.pem
printf '%s\n' '-----BEGIN PRIVATE KEY-----' 'SUPER-SECRET-MATERIAL' '-----END PRIVATE KEY-----' >"$private_key"
run_preview "$private_key" "$output" "$error"
assert_contains "$output" 'Preview suppressed'
assert_not_contains "$output" 'SUPER-SECRET-MATERIAL'

pfx=$TMP_DIR/private.p12
printf 'SUPER-SECRET-PFX\n' >"$pfx"
run_preview "$pfx" "$output" "$error"
assert_contains "$output" 'Preview suppressed'
assert_not_contains "$output" 'SUPER-SECRET-PFX'

archive_source=$TMP_DIR/archive-source
mkdir "$archive_source"
printf 'archive member\n' >"$archive_source/member.txt"
archive=$TMP_DIR/archive.tar
tar --create --file="$archive" -C "$archive_source" member.txt
run_preview "$archive" "$output" "$error"
assert_contains "$output" 'member.txt'

image=$ROOT_DIR/tmux/plugins/catppuccin/assets/latte.webp
[[ -f $image ]] || fail 'image fixture is unavailable'
run_preview "$image" "$output" "$error"
assert_contains "$output" $'\033'

link=$TMP_DIR/link.txt
ln -s "$plain" "$link"
run_preview "$link" "$output" "$error"
assert_contains "$output" 'symbolic link'
assert_not_contains "$output" 'line 1'

broken=$TMP_DIR/broken
ln -s "$TMP_DIR/missing" "$broken"
run_preview "$broken" "$output" "$error"
assert_contains "$output" 'broken or unresolved'

fifo=$TMP_DIR/pipe
mkfifo "$fifo"
run_preview "$fifo" "$output" "$error"
assert_contains "$output" 'metadata only'
assert_contains "$output" 'fifo'

if "$PREVIEW" "$TMP_DIR/missing" >"$output" 2>"$error"; then
    fail 'missing path was accepted'
fi
assert_contains "$error" 'path does not exist'

slow_bin=$TMP_DIR/slow-bin
mkdir "$slow_bin"
printf '#!/usr/bin/env bash\nsleep 3\n' >"$slow_bin/eza"
chmod +x "$slow_bin/eza"
if PATH="$slow_bin:$PATH" PREVIEW_TIMEOUT_SECONDS=1 "$PREVIEW" "$directory" >"$output" 2>"$error"; then
    fail 'preview timeout was not enforced'
fi
assert_contains "$error" 'timed out'

printf 'test-preview: PASS\n'
