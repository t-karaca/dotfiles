#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." >/dev/null 2>&1 && pwd)
LIST=$ROOT_DIR/bin/fs-list
EZA=$(command -v eza || true)
TMP_DIR=$(mktemp -d)
trap 'rm -rf -- "$TMP_DIR"' EXIT

fail() {
    printf 'test-list: %s\n' "$1" >&2
    exit 1
}

assert_contains() {
    local file=$1
    local text=$2
    [[ $(<"$file") == *"$text"* ]] || fail "missing '$text'"
}

assert_record_contains() {
    local file=$1
    local text=$2
    local record

    while IFS= read -r record || [[ -n $record ]]; do
        [[ $record == *"$text"* ]] && return 0
    done <"$file"
    fail "missing '$text' in line-delimited records"
}

assert_record_not_contains() {
    local file=$1
    local text=$2
    local record

    while IFS= read -r record || [[ -n $record ]]; do
        [[ $record == *"$text"* ]] && fail "unexpected '$text' in line-delimited records"
    done <"$file"
    return 0
}

record_field() {
    local record=$1
    local field_number=$2
    local field
    local i

    field=$record
    for ((i = 1; i < field_number; i++)); do
        field=${field#*$'\t'}
    done
    printf '%s' "${field%%$'\t'*}"
}

root=$TMP_DIR/root
mkdir "$root" "$root/nested"
printf 'deep\n' >"$root/nested/deep.txt"
printf 'one\n' >"$root/file 1.txt"
printf 'two\n' >"$root/file 2.txt"
printf 'ten\n' >"$root/file 10.txt"
printf 'special\n' >"$root/quote ' \$().txt"
printf 'leading\n' >"$root/-leading.txt"
printf 'unicode\n' >"$root/Δ.txt"
printf 'shell\n' >"$root/script.sh"
printf 'json\n' >"$root/data.json"
printf 'markdown\n' >"$root/README.md"
printf 'docker\n' >"$root/Dockerfile"
printf 'image\n' >"$root/image.png"
printf 'pdf\n' >"$root/document.pdf"
printf 'archive\n' >"$root/archive.tar.gz"
newline_name=$'newline\nname.txt'
tab_name=$'tab\tname.txt'
cr_name=$'cr\rname.txt'
control_name=$'control\001name.txt'
printf 'newline\n' >"$root/$newline_name"
printf 'tab\n' >"$root/$tab_name"
printf 'carriage return\n' >"$root/$cr_name"
printf 'control\n' >"$root/$control_name"
printf 'hidden\n' >"$root/.hidden.txt"
ln -s nested "$root/link-dir"
ln -s missing "$root/broken-link"

output=$TMP_DIR/output
error=$TMP_DIR/error
[[ -n $EZA ]] || fail 'eza is required for this test'
"$LIST" "$root" >"$output" 2>"$error"

mapfile -t records <"$output"
[[ ${#records[@]} == 16 ]] || fail "expected 16 visible records, got ${#records[@]}"
[[ $(wc -l <"$output") == 16 ]] || fail 'records are not line-delimited'

first_result=$(record_field "${records[0]}" 1)
[[ $first_result == "$root/nested" ]] || fail 'directories are not emitted first'

for record in "${records[@]}"; do
    result=$(record_field "$record" 1)
    [[ $result == "$root"/* ]] || fail 'result is not an absolute child path'
    [[ $result != *$'\t'* ]] || fail 'result contains a literal tab'
    tab_count=0
    remainder=$record
    while [[ $remainder == *$'\t'* ]]; do
        tab_count=$((tab_count + 1))
        remainder=${remainder#*$'\t'}
    done
    [[ $tab_count == 3 ]] || fail 'record does not have four fields'
done

for record in "${records[@]}"; do
    result=$(record_field "$record" 1)
    [[ $result != "$root/nested/deep.txt" ]] || fail 'fs-list recursed into a child directory'
    [[ ${record#*$'\t'} != *"$root"* ]] || fail 'display/search fields contain the absolute root'
done

link_record=''
for record in "${records[@]}"; do
    result=$(record_field "$record" 1)
    if [[ $result == "$root/link-dir" ]]; then
        link_record=$record
    fi
done
[[ -n $link_record ]] || fail 'directory symlink is missing'
[[ $link_record == *'->'* ]] || fail 'eza symlink rendering is missing'

file_results=()
for record in "${records[@]}"; do
    result=$(record_field "$record" 1)
    [[ $result == "$root/file "* ]] && file_results+=("$result")
done
[[ ${file_results[0]} == "$root/file 1.txt" ]] || fail 'natural sort did not put file 1 first'
[[ ${file_results[1]} == "$root/file 2.txt" ]] || fail 'natural sort did not put file 2 second'
[[ ${file_results[2]} == "$root/file 10.txt" ]] || fail 'natural sort did not put file 10 third'

expected_names=(
    nested
    broken-link
    link-dir
    Dockerfile
    README.md
    archive.tar.gz
    data.json
    document.pdf
    'file 1.txt'
    'file 2.txt'
    'file 10.txt'
    image.png
    "quote ' \$().txt"
    script.sh
    -leading.txt
    Δ.txt
)
expected_display=$TMP_DIR/expected-display
(
    cd -- "$root"
    "$EZA" \
        --oneline \
        --icons=always \
        --color=always \
        --hyperlink=never \
        --sort=none \
        --classify=always \
        --treat-dirs-as-files \
        --no-quotes \
        -- "${expected_names[@]}"
) >"$expected_display"
mapfile -t expected_lines <"$expected_display"
[[ ${#expected_lines[@]} == ${#records[@]} ]] || fail 'standalone eza output has an unexpected number of lines'
for i in "${!records[@]}"; do
    [[ $(record_field "${records[i]}" 3) == "${expected_lines[i]}" ]] || fail "record $((i + 1)) does not preserve eza display"
done
[[ $(record_field "${records[0]}" 3) == *$'\e['* ]] || fail 'eza color output was not preserved'

"$LIST" --hidden "$root" >"$output" 2>"$error"
assert_record_contains "$output" '.hidden.txt'

fake_bin=$TMP_DIR/fake-bin
mkdir "$fake_bin"
calls=$TMP_DIR/eza-calls
fake_eza=$fake_bin/eza
printf '#!/usr/bin/env bash\nprintf x >>"$EZA_CALLS"\nexec "$REAL_EZA" "$@"\n' >"$fake_eza"
chmod +x "$fake_eza"
PATH="$fake_bin:$PATH" EZA_CALLS="$calls" REAL_EZA="$EZA" "$LIST" "$root" >"$output" 2>"$error"
[[ $(wc -c <"$calls") == 1 ]] || fail 'fs-list invoked eza more than once'

FZF_RECORD_DEBUG=1 "$LIST" "$root" >"$output" 2>"$error"
assert_record_not_contains "$output" $'tab\tname.txt'
assert_record_not_contains "$output" $'newline\nname.txt'
assert_record_not_contains "$output" $'cr\rname.txt'
assert_record_not_contains "$output" $'control\001name.txt'
assert_contains "$error" 'unsupported control character in filename'

if "$LIST" "$root/missing" >"$output" 2>"$error"; then
    fail 'missing directory was accepted'
fi
assert_contains "$error" 'directory is unavailable'

printf 'test-list: PASS\n'
