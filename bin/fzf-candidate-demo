#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)

usage() {
    printf 'Usage: %s {records|select [fzf options]}\n' "${0##*/}"
}

emit_record() {
    local result=$1
    local search=$2
    local display=$3
    local metadata=$4
    local field
    local field_name

    for field_name in result search display metadata; do
        field=${!field_name}
        [[ $field != *$'\t'* ]] || {
            printf 'fzf-candidate-demo: %s fields cannot contain literal tabs.\n' "$field_name" >&2
            return 1
        }
    done
    local LC_ALL=C
    [[ ! $result =~ [[:cntrl:]] ]] || {
        printf 'fzf-candidate-demo: result fields cannot contain control characters.\n' >&2
        return 1
    }
    [[ $search != *$'\n'* && $search != *$'\r'* && $display != *$'\n'* && $display != *$'\r'* \
        && $metadata != *$'\n'* && $metadata != *$'\r'* ]] || {
        printf 'fzf-candidate-demo: non-result fields cannot contain line breaks.\n' >&2
        return 1
    }
    printf '%s\t%s\t%s\t%s\n' "$result" "$search" "$display" "$metadata"
}

records() {
    emit_record \
        "notes/space quote ' \" \$() ; | & [brackets].md" \
        'notes space quote shell metacharacters' \
        $'\e[38;2;137;180;250mSpecial characters\e[0m' \
        'kind=text'
    emit_record \
        'notes/line-safe-filename.md' \
        'notes line safe filename' \
        $'\e[38;2;166;227;161mLine-safe filename\e[0m' \
        'kind=text'
    emit_record \
        'data/example.json' \
        'data json example' \
        $'\e[38;2;249;226;175mJSON example\e[0m' \
        'kind=json'
    emit_record \
        '-leading/Δ file.txt' \
        'leading dash unicode' \
        $'\e[38;2;203;166;247mLeading dash and Unicode\e[0m' \
        'kind=text'
}

case ${1:-} in
    records)
        records
        ;;
    select)
        shift
        records | "$ROOT_DIR/bin/fzf-record-select" "$@"
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
