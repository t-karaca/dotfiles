#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)
STATE_DIR=${FZF_NAVIGATOR_STATE_DIR:-}
ACTION_COMMAND='"$FZF_NAVIGATOR_BIN_DIR/fzf-navigator-action"'
SOURCE_COMMAND='"$FZF_NAVIGATOR_BIN_DIR/fzf-navigator-source"'
TIMEOUT_SECONDS=${FZF_NAVIGATOR_TIMEOUT_SECONDS:-5}

setup_logging() {
    local log_dir

    if [[ -n ${FZF_NAVIGATOR_LOG_FILE:-} ]]; then
        LOG_FILE=$FZF_NAVIGATOR_LOG_FILE
    elif [[ -n ${XDG_STATE_HOME:-} ]]; then
        LOG_FILE=$XDG_STATE_HOME/fzf-navigator/fzf-navigator.log
    elif [[ -n ${HOME:-} ]]; then
        LOG_FILE=$HOME/.local/state/fzf-navigator/fzf-navigator.log
    else
        return 1
    fi
    log_dir=${LOG_FILE%/*}
    [[ -n $log_dir && $log_dir != "$LOG_FILE" ]] || return 1
    mkdir -p -- "$log_dir" 2>/dev/null || return 1
    : >>"$LOG_FILE" 2>/dev/null || return 1
    exec 2>>"$LOG_FILE"
}

fail() {
    printf 'fzf-navigator-action: %s\n' "$1" >&2
    exit 1
}

die() {
    printf 'fzf-navigator-action: %s\n' "$1" >&2
    exit 2
}

setup_logging || exit 1

supported_path() {
    local LC_ALL=C

    [[ $1 == /* && ! $1 =~ [[:cntrl:]] ]]
}

require_state_dir() {
    [[ -n $STATE_DIR && -d $STATE_DIR ]] || fail 'private navigator state is unavailable'
}

state_value() {
    local name=$1
    local file=$STATE_DIR/$name
    local value

    [[ -f $file ]] || fail "state is unavailable: $name"
    IFS= read -r value <"$file" || fail "state is malformed: $name"
    printf '%s' "$value"
}

write_state() {
    local name=$1
    local value=$2
    local temporary

    temporary=$(mktemp "$STATE_DIR/.${name}.XXXXXX") || fail "could not create $name state"
    printf '%s\n' "$value" >"$temporary"
    mv -f -- "$temporary" "$STATE_DIR/$name"
}

load_state() {
    cwd=$(state_value cwd)
    start_cwd=$(state_value start-cwd)
    git_root=$(state_value git-root)
    mode=$(state_value mode)
    sort_mode=$(state_value sort-mode)
    show_hidden=$(state_value show-hidden)
    show_ignored=$(state_value show-ignored)

    supported_path "$cwd" || fail 'current directory state is malformed'
    supported_path "$start_cwd" || fail 'starting directory state is malformed'
    [[ -z $git_root ]] || supported_path "$git_root" || fail 'Git root state is malformed'
    case $mode in
        browse|find|grep) ;;
        *) fail "invalid mode in state: $mode" ;;
    esac
    case $sort_mode in
        ascending|recent|descending) ;;
        *) fail "invalid sort mode in state: $sort_mode" ;;
    esac
    case $show_hidden in
        true|false) ;;
        *) fail 'hidden visibility state is malformed' ;;
    esac
    case $show_ignored in
        true|false) ;;
        *) fail 'ignored visibility state is malformed' ;;
    esac
    [[ $TIMEOUT_SECONDS =~ ^[0-9]+$ ]] || fail 'timeout must be a non-negative integer'
}

display_path() {
    local path=$1

    if [[ -n ${HOME:-} && ($path == "$HOME" || $path == "$HOME"/*) ]]; then
        printf '~%s' "${path#"$HOME"}"
    else
        printf '%s' "$path"
    fi
}

sort_label() {
    case $sort_mode in
        ascending) printf 'A-Z' ;;
        recent) printf 'Recent' ;;
        descending) printf 'Z-A' ;;
    esac
}

timeout_label() {
    if [[ $TIMEOUT_SECONDS == 0 ]]; then
        printf 'Off'
    else
        printf '%ss' "$TIMEOUT_SECONDS"
    fi
}

require_query() {
    (($# == 1)) || die 'expected the current query'
}

require_fzf_commands() {
    [[ -n ${FZF_NAVIGATOR_BIN_DIR:-} ]] || fail 'navigator command directory is unavailable'
    [[ -x $FZF_NAVIGATOR_BIN_DIR/fzf-navigator-source ]] || fail 'source helper is unavailable'
    [[ -x $FZF_NAVIGATOR_BIN_DIR/fzf-navigator-action ]] || fail 'action helper is unavailable'
}

resolve_path() {
    (($# == 1)) || die 'resolve-path expects a selected value'
    local selected=$1
    local relative_path
    local path

    case $mode in
        browse|find)
            [[ $selected == *' '* ]] || fail 'selected path is missing its eza icon'
            relative_path=${selected#* }
            ;;
        grep)
            relative_path=$selected
            ;;
    esac
    relative_path=${relative_path#./}
    [[ -n $relative_path && $relative_path != /* && ! $relative_path =~ [[:cntrl:]] ]] || fail 'selected path is malformed'

    if [[ $cwd == / ]]; then
        path=/$relative_path
    else
        path=$cwd/$relative_path
    fi
    supported_path "$path" || fail 'resolved path is malformed'
    [[ -e $path || -L $path ]] || fail "selected path is unavailable: $path"
    printf '%s\n' "$path"
}

reload_action() {
    if [[ $mode == grep ]]; then
        printf 'reload(%s --query {q})' "$SOURCE_COMMAND"
    else
        printf 'reload(%s)' "$SOURCE_COMMAND"
    fi
}

render_refresh() {
    local query_policy=$1
    local actions
    local reload

    require_fzf_commands
    case $query_policy in
        clear|preserve) ;;
        *) die "invalid query policy: $query_policy" ;;
    esac

    reload=$(reload_action)
    actions="transform-header($ACTION_COMMAND header)+transform-prompt($ACTION_COMMAND prompt)"
    if [[ $mode == grep ]]; then
        actions+='+disable-search+rebind(change)'
    else
        actions+='+unbind(change)+enable-search'
    fi
    [[ $query_policy == clear ]] && actions+='+clear-query'
    actions+="+$reload+first"
    printf '%s\n' "$actions"
}

preview() {
    (($# == 3)) || die 'preview expects value, line, and column'
    local selected=$1
    local line=$2
    local column=$3
    local path
    local appearance

    path=$(resolve_path "$selected")
    case $mode in
        browse|find)
            "$SCRIPT_DIR/preview-dispatcher" "$path"
            ;;
        grep)
            [[ $line =~ ^[1-9][0-9]*$ && $column =~ ^[1-9][0-9]*$ ]] || die 'Grep preview metadata is malformed'
            appearance=${FZF_NAVIGATOR_APPEARANCE:-}
            case $appearance in
                light|dark) ;;
                *) fail 'Grep preview appearance is malformed' ;;
            esac
            command -v bat >/dev/null 2>&1 || fail 'bat is required for Grep previews'
            bat \
                --paging=never \
                --style=numbers \
                --theme="$appearance" \
                --color=always \
                --highlight-line="$line" \
                -- "$path"
            ;;
    esac
}

run_open() {
    (($# == 0)) || die 'run-open expects no arguments'
    local path

    path=$(state_value open-path)
    supported_path "$path" || fail 'open path is malformed'
    [[ -e $path || -L $path ]] || fail "open path is unavailable: $path"
    command -v xdg-open >/dev/null 2>&1 || fail 'xdg-open is required'

    if [[ -r /dev/tty && -w /dev/tty ]]; then
        printf '\033[2J\033[H' >/dev/tty
        xdg-open -- "$path" </dev/tty >/dev/null 2>>"$LOG_FILE"
    else
        xdg-open -- "$path" >/dev/null 2>>"$LOG_FILE"
    fi
}

open() {
    (($# == 1)) || die 'open expects a selected value'
    local path

    path=$(resolve_path "$1")
    command -v xdg-open >/dev/null 2>&1 || fail 'xdg-open is required'

    if [[ -d $path ]]; then
        nohup xdg-open -- "$path" >/dev/null 2>>"$LOG_FILE" &
        printf 'refresh-preview\n'
    else
        write_state open-path "$path"
        printf '%s\n' 'execute("$FZF_NAVIGATOR_BIN_DIR/fzf-navigator-action" run-open)+refresh-preview'
    fi
}

enter() {
    (($# == 2)) || die 'enter expects a selected value and query'
    local path

    path=$(resolve_path "$1")
    if [[ $mode == grep ]]; then
        write_state cwd "$(dirname -- "$path")"
        write_state mode browse
        render_refresh clear
    elif [[ -d $path ]]; then
        write_state cwd "$path"
        render_refresh clear
    elif [[ $mode == find ]]; then
        write_state cwd "$(dirname -- "$path")"
        write_state mode browse
        render_refresh clear
    fi
}

refresh_location() {
    if [[ $mode == grep ]]; then
        render_refresh preserve
    else
        render_refresh clear
    fi
}

parent() {
    require_query "$@"
    local destination

    if [[ $cwd == / ]]; then
        destination=/
    else
        destination=${cwd%/*}
        [[ -n $destination ]] || destination=/
    fi
    [[ -d $destination ]] || fail "parent directory is unavailable: $destination"
    write_state cwd "$destination"
    refresh_location
}

start() {
    require_query "$@"
    [[ -d $start_cwd ]] || fail "starting directory is unavailable: $start_cwd"
    write_state cwd "$start_cwd"
    refresh_location
}

git_root_action() {
    require_query "$@"
    if [[ -z $git_root ]]; then
        printf 'change-header(Git root unavailable for launch directory)+bell\n'
        return
    fi
    [[ -d $git_root ]] || fail "Git root is unavailable: $git_root"
    write_state cwd "$git_root"
    refresh_location
}

toggle_sort() {
    require_query "$@"
    local next_mode

    [[ $mode == browse ]] || return
    case $sort_mode in
        ascending) next_mode=recent ;;
        recent) next_mode=descending ;;
        descending) next_mode=ascending ;;
    esac
    write_state sort-mode "$next_mode"
    render_refresh preserve
}

toggle_visibility() {
    (($# == 2)) || die 'visibility toggle expects state name and query'
    local name=$1
    local value

    case $name in
        show-hidden|show-ignored) ;;
        *) die "invalid visibility state: $name" ;;
    esac
    value=$(state_value "$name")
    case $value in
        false) write_state "$name" true ;;
        true) write_state "$name" false ;;
        *) fail "visibility state is malformed: $name" ;;
    esac
    render_refresh preserve
}

transition_mode() {
    (($# == 2)) || die 'mode transition expects a mode and query'
    local next_mode=$1

    case $next_mode in
        browse|find|grep) ;;
        *) die "unsupported mode: $next_mode" ;;
    esac
    write_state mode "$next_mode"
    mode=$next_mode
    render_refresh preserve
}

cycle_mode() {
    require_query "$@"

    case $mode in
        browse) transition_mode find "$1" ;;
        find) transition_mode grep "$1" ;;
        grep) transition_mode browse "$1" ;;
    esac
}

header() {
    local result

    case $mode in
        browse) result="Mode: Browse | Sort: $(sort_label)" ;;
        find) result="Mode: Find | Timeout: $(timeout_label)" ;;
        grep) result="Mode: Grep | Timeout: $(timeout_label)" ;;
    esac
    [[ $show_hidden == true ]] && result+=' | Hidden: On'
    [[ $show_ignored == true ]] && result+=' | Ignored: On'
    printf '%s\n' "$result"
}

prompt() {
    printf '%s > \n' "$(display_path "$cwd")"
}

usage() {
    printf 'Usage: %s <command> [arguments...]\n' "${0##*/}"
}

main() {
    (($# > 0)) || {
        usage >&2
        return 2
    }

    local command=$1
    shift
    case $command in
        -h|--help)
            (($# == 0)) || die 'help expects no arguments'
            usage
            return 0
            ;;
    esac

    require_state_dir
    case $command in
        run-open) run_open "$@" ;;
        *)
            load_state
            case $command in
                preview) preview "$@" ;;
                resolve-path) resolve_path "$@" ;;
                open) open "$@" ;;
                enter) enter "$@" ;;
                parent) parent "$@" ;;
                start) start "$@" ;;
                git-root) git_root_action "$@" ;;
                toggle-sort) toggle_sort "$@" ;;
                toggle-hidden) require_query "$@"; toggle_visibility show-hidden "$@" ;;
                toggle-ignored) require_query "$@"; toggle_visibility show-ignored "$@" ;;
                cycle-mode) cycle_mode "$@" ;;
                header) (($# == 0)) || die 'header expects no arguments'; header ;;
                prompt) (($# == 0)) || die 'prompt expects no arguments'; prompt ;;
                *) die "unknown command: $command" ;;
            esac
            ;;
    esac
}

main "$@"
