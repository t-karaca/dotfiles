#!/usr/bin/env bash

set -euo pipefail

STATE_DIR=${FZF_NAVIGATOR_STATE_DIR:-}
FIELD_SEPARATOR=${FZF_NAVIGATOR_FIELD_SEPARATOR:-$'\x1f:'}
TIMEOUT_SECONDS=${FZF_NAVIGATOR_TIMEOUT_SECONDS:-5}
query=''

setup_logging() {
    local log_dir

    if [[ -n ${FZF_NAVIGATOR_LOG_FILE:-} ]]; then
        LOG_FILE=$FZF_NAVIGATOR_LOG_FILE
    elif [[ -n ${XDG_STATE_HOME:-} ]]; then
        LOG_FILE=$XDG_STATE_HOME/fzf-navigator/fzf-navigator.log
    elif [[ -n ${HOME:-} ]]; then
        LOG_FILE=$HOME/.local/state/fzf-navigator/fzf-navigator.log
    else
        return 1
    fi
    log_dir=${LOG_FILE%/*}
    [[ -n $log_dir && $log_dir != "$LOG_FILE" ]] || return 1
    mkdir -p -- "$log_dir" 2>/dev/null || return 1
    : >>"$LOG_FILE" 2>/dev/null || return 1
    exec 2>>"$LOG_FILE"
}

fail() {
    printf 'fzf-navigator-source: %s\n' "$1" >&2
    exit 1
}

die() {
    printf 'fzf-navigator-source: %s\n' "$1" >&2
    exit 2
}

setup_logging || exit 1

supported_path() {
    local LC_ALL=C

    [[ $1 == /* && ! $1 =~ [[:cntrl:]] ]]
}

state_value() {
    local name=$1
    local file=$STATE_DIR/$name
    local value

    [[ -f $file ]] || fail "state is unavailable: $name"
    IFS= read -r value <"$file" || fail "state is malformed: $name"
    printf '%s' "$value"
}

require_timeout() {
    [[ $TIMEOUT_SECONDS =~ ^[0-9]+$ ]] || fail 'timeout must be a non-negative integer'
}

while (($# > 0)); do
    case $1 in
        --query)
            (($# >= 2)) || die '--query requires a value'
            query=$2
            shift 2
            ;;
        --query=*)
            query=${1#*=}
            shift
            ;;
        -h|--help)
            printf 'Usage: %s [--query QUERY]\n' "${0##*/}"
            exit 0
            ;;
        *)
            die "unknown option: $1"
            ;;
    esac
done

[[ -n $STATE_DIR && -d $STATE_DIR ]] || fail 'private navigator state is unavailable'

cwd=$(state_value cwd)
mode=$(state_value mode)
sort_mode=$(state_value sort-mode)
show_hidden=$(state_value show-hidden)
show_ignored=$(state_value show-ignored)
supported_path "$cwd" || fail 'current directory state is malformed'
[[ -d $cwd ]] || fail "current directory is unavailable: $cwd"
[[ $FIELD_SEPARATOR == $'\x1f:' ]] || fail 'field separator is malformed'
require_timeout

case $mode in
    browse|find|grep) ;;
    *) fail "invalid mode in state: $mode" ;;
esac
case $sort_mode in
    ascending|recent|descending) ;;
    *) fail "invalid sort mode in state: $sort_mode" ;;
esac
case $show_hidden in
    true|false) ;;
    *) fail 'hidden visibility state is malformed' ;;
esac
case $show_ignored in
    true|false) ;;
    *) fail 'ignored visibility state is malformed' ;;
esac

run_decorated_fd() {
    local -a fd_args=(
        fd
        --type file
        --type directory
        --type symlink
        --exclude '*[[:cntrl:]]*'
    )
    local -a eza_args=(
        eza
        --stdin
        --oneline
        --icons=always
        --color=always
        --hyperlink=never
        --no-quotes
        --treat-dirs-as-files
        --dereference
    )
    local -a pipeline_status
    local fd_status
    local eza_status

    command -v fd >/dev/null 2>&1 || fail "fd is required for ${mode^} mode"
    command -v eza >/dev/null 2>&1 || fail 'eza is required'

    [[ $show_hidden == true ]] && fd_args+=(--hidden)
    [[ $show_ignored == true ]] && fd_args+=(--no-ignore)

    case $mode in
        browse)
            fd_args+=(--max-depth 1)
            case $sort_mode in
                ascending) eza_args+=(--sort=name --group-directories-first) ;;
                recent) eza_args+=(--sort=modified --group-directories-last) ;;
                descending) eza_args+=(--sort=name --reverse --group-directories-last) ;;
            esac
            ;;
        find)
            eza_args+=(--sort=none)
            if [[ $TIMEOUT_SECONDS != 0 ]]; then
                command -v timeout >/dev/null 2>&1 || fail 'timeout is required for Find mode'
            fi
            ;;
    esac
    fd_args+=(.)

    set +e
    (
        cd -- "$cwd" || exit
        if [[ $mode == find && $TIMEOUT_SECONDS != 0 ]]; then
            timeout "$TIMEOUT_SECONDS" "${fd_args[@]}"
        else
            "${fd_args[@]}"
        fi
    ) | (
        cd -- "$cwd" || exit
        "${eza_args[@]}"
    )
    pipeline_status=("${PIPESTATUS[@]}")
    set -e

    fd_status=${pipeline_status[0]}
    eza_status=${pipeline_status[1]}

    case $fd_status in
        0) ;;
        124) [[ $mode == find ]] || return "$fd_status" ;;
        141) return "$fd_status" ;;
        *) fail "fd failed (exit $fd_status)" ;;
    esac
    case $eza_status in
        0) ;;
        141) return "$eza_status" ;;
        *) fail "eza failed (exit $eza_status)" ;;
    esac
}

run_grep() {
    local -a rg_args=(
        rg
        --no-config
        --fixed-strings
        --smart-case
        --line-number
        --column
        --with-filename
        --no-heading
        --color=always
        --field-match-separator="$FIELD_SEPARATOR"
    )
    local rg_status

    [[ -n $query ]] || return 0
    command -v rg >/dev/null 2>&1 || fail 'rg is required for Grep mode'
    [[ $TIMEOUT_SECONDS == 0 ]] || command -v timeout >/dev/null 2>&1 || fail 'timeout is required for Grep mode'

    [[ $show_hidden == true ]] && rg_args+=(--hidden)
    [[ $show_ignored == true ]] && rg_args+=(--no-ignore)
    rg_args+=(-- "$query")

    set +e
    (
        cd -- "$cwd" || exit
        if [[ $TIMEOUT_SECONDS == 0 ]]; then
            "${rg_args[@]}"
        else
            timeout "$TIMEOUT_SECONDS" "${rg_args[@]}"
        fi
    )
    rg_status=$?
    set -e

    case $rg_status in
        0|1|124) ;;
        141) return "$rg_status" ;;
        *) fail "rg failed (exit $rg_status)" ;;
    esac
}

case $mode in
    browse|find) run_decorated_fd ;;
    grep) run_grep ;;
esac
