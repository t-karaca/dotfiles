#!/usr/bin/env bash

set -euo pipefail

hidden=false
debug=${FZF_RECORD_DEBUG:-0}
directory_arg=''

usage() {
    printf 'Usage: %s [--hidden] [--debug] <directory>\n' "${0##*/}"
}

fail() {
    printf 'fs-list: %s\n' "$1" >&2
    exit 1
}

die() {
    printf 'fs-list: %s\n' "$1" >&2
    exit 2
}

debug_skip() {
    if [[ $debug == 1 ]]; then
        printf 'fs-list: skipping %s: %s\n' "$1" "$2" >&2
    fi
}

supported_path() {
    local value=$1
    local LC_ALL=C

    [[ ! $value =~ [[:cntrl:]] ]]
}

relative_name() {
    local entry=$1

    if [[ $directory == / ]]; then
        printf '%s' "${entry#/}"
    else
        printf '%s' "${entry#"$directory"/}"
    fi
}

sort_entries() {
    (($# > 0)) || return 0
    printf '%s\n' "$@" | LC_ALL=C sort -V
}

append_group() {
    local entry
    local relative
    local -a sorted=()

    (($# > 0)) || return 0
    mapfile -t sorted < <(sort_entries "$@")
    for entry in "${sorted[@]}"; do
        relative=$(relative_name "$entry")
        ordered_results+=("$entry")
        ordered_names+=("$relative")
    done
}

emit_record() {
    local result=$1
    local search=$2
    local display=$3
    local metadata=$4

    if [[ $result == *$'\t'* || $result == *$'\n'* || $result == *$'\r'* ]]; then
        debug_skip "$result" 'unsupported control character in result path'
        return
    fi
    if [[ $search == *$'\t'* || $display == *$'\t'* || $metadata == *$'\t'* ]]; then
        debug_skip "$result" 'eza display or record fields contain a literal tab'
        return
    fi
    printf '%s\t%s\t%s\t%s\n' "$result" "$search" "$display" "$metadata"
}

while (($# > 0)); do
    case $1 in
        -h|--help)
            usage
            exit 0
            ;;
        --hidden|-H)
            hidden=true
            shift
            ;;
        --debug)
            debug=1
            shift
            ;;
        --)
            shift
            (($# == 1 && -z $directory_arg)) || die 'expected one directory'
            directory_arg=$1
            shift
            ;;
        -*|*)
            if [[ -z $directory_arg && $1 == -* ]]; then
                die "unknown option: $1"
            fi
            [[ -z $directory_arg ]] || die 'expected one directory'
            directory_arg=$1
            shift
            ;;
    esac
done

[[ -n $directory_arg ]] || die 'a directory is required'
supported_path "$directory_arg" || fail 'directory paths containing control characters are unsupported'
directory=$(cd -- "$directory_arg" 2>/dev/null && pwd -P) || fail "directory is unavailable: $directory_arg"
[[ -r $directory ]] || fail "directory is not readable: $directory"
command -v eza >/dev/null 2>&1 || fail 'eza is required'

shopt -s nullglob
entries=("$directory"/*)
if [[ $hidden == true ]]; then
    entries+=("$directory"/.[!.]* "$directory"/..?*)
fi

directories=()
symlinks=()
other_entries=()
for entry in "${entries[@]}"; do
    [[ -e $entry || -L $entry ]] || continue
    if [[ $directory == / && $entry == //* ]]; then
        entry="/${entry#//}"
    fi
    if ! supported_path "$entry"; then
        debug_skip "$entry" 'unsupported control character in filename'
        continue
    fi
    if [[ -L $entry ]]; then
        symlinks+=("$entry")
    elif [[ -d $entry ]]; then
        directories+=("$entry")
    else
        other_entries+=("$entry")
    fi
done

ordered_results=()
ordered_names=()
append_group "${directories[@]}"
append_group "${symlinks[@]}"
append_group "${other_entries[@]}"

((${#ordered_results[@]} > 0)) || exit 0

display_file=$(mktemp)
trap 'rm -f -- "$display_file"' EXIT
(
    cd -- "$directory"
    eza \
        --oneline \
        --icons=always \
        --color=always \
        --hyperlink=never \
        --sort=none \
        --classify=always \
        --treat-dirs-as-files \
        --no-quotes \
        -- "${ordered_names[@]}"
) >"$display_file" || fail 'eza failed to render the directory entries'

displays=()
mapfile -t displays <"$display_file"
[[ ${#displays[@]} == ${#ordered_results[@]} ]] || fail 'eza returned an unexpected number of display lines'

for i in "${!ordered_results[@]}"; do
    result=${ordered_results[i]}
    relative=${ordered_names[i]}
    emit_record "$result" "$relative" "${displays[i]}" ''
done
