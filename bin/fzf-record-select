#!/usr/bin/env bash

set -euo pipefail

usage() {
    printf 'Usage: producer | %s [fzf options]\n' "${0##*/}"
}

extract_results() {
    local record

    while IFS= read -r -d '' record; do
        [[ $record == *$'\t'* ]] || continue
        # Result fields may contain newlines but not literal tabs.
        printf '%s\0' "${record%%$'\t'*}"
    done
}

case ${1:-} in
    -h|--help)
        usage
        exit 0
        ;;
esac

fzf --read0 --print0 --ansi --delimiter=$'\t' --with-nth=3 --nth=2,3 "$@" | extract_results
