#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: producer | fzf-record-select [--output result|record] [fzf options]

Input records are line-delimited and have four tab-delimited fields:
  result<TAB>search<TAB>display<TAB>metadata<LF>

The default output is one selected result per line. Use --output record to
return the complete selected record. FZF_RECORD_DEBUG=1 reports skipped
malformed records to stderr.
EOF
}

die() {
    printf 'fzf-record-select: %s\n' "$1" >&2
    exit 2
}

debug_skip() {
    if [[ ${FZF_RECORD_DEBUG:-0} == 1 ]]; then
        printf 'fzf-record-select: skipping record %s: %s\n' "$1" "$2" >&2
    fi
}

valid_record() {
    local record=$1
    local remainder=$record
    local tab_count=0
    local result

    while [[ $remainder == *$'\t'* ]]; do
        tab_count=$((tab_count + 1))
        remainder=${remainder#*$'\t'}
    done

    ((tab_count == 3)) || return 1
    result=${record%%$'\t'*}
    [[ -n $result ]] || return 1
    local LC_ALL=C
    [[ ! $result =~ [[:cntrl:]] ]]
}

validate_records() {
    local record
    local record_number=0

    while IFS= read -r record || [[ -n $record ]]; do
        record_number=$((record_number + 1))
        if valid_record "$record"; then
            printf '%s\n' "$record"
        else
            debug_skip "$record_number" 'expected a non-empty result and exactly three tab delimiters'
        fi
    done
}

extract_results() {
    local record
    local record_number=0

    while IFS= read -r record || [[ -n $record ]]; do
        record_number=$((record_number + 1))
        if valid_record "$record"; then
            printf '%s\n' "${record%%$'\t'*}"
        else
            debug_skip "$record_number" 'fzf returned a malformed record'
        fi
    done
}

output=result
fzf_args=()

while (($# > 0)); do
    case $1 in
        -h|--help)
            usage
            exit 0
            ;;
        --output)
            (($# >= 2)) || die '--output requires result or record'
            output=$2
            shift 2
            ;;
        --output=*)
            output=${1#*=}
            shift
            ;;
        --read0|--read0=*|--no-read0|-0)
            die 'NUL input is unsupported; fzf-record-select uses line-based records'
            ;;
        --print0|--print0=*|--no-print0)
            die 'NUL output is unsupported; fzf-record-select uses line-based records'
            ;;
        --delimiter|--delimiter=*|-d|-d?*)
            die 'the tab delimiter is owned by fzf-record-select'
            ;;
        --print-query|--print-query=*)
            die '--print-query would corrupt the line output protocol'
            ;;
        --expect|--expect=*)
            die '--expect would corrupt the line output protocol'
            ;;
        --accept-nth|--accept-nth=*)
            die '--accept-nth would corrupt the selected record'
            ;;
        *)
            fzf_args+=("$1")
            shift
            ;;
    esac
done

case $output in
    result|record) ;;
    *) die "invalid output mode '$output' (expected result or record)" ;;
esac

# Show only the human/eza display field. fzf filters the rendered display.
presentation_args=(--ansi --with-nth=3)
# The tab delimiter is appended after caller options so the field transport
# cannot be redirected by a picker. Input and output remain line-based.
transport_args=(--delimiter=$'\t')

validate_records | {
    if [[ $output == record ]]; then
        fzf "${presentation_args[@]}" "${fzf_args[@]}" "${transport_args[@]}"
    else
        fzf "${presentation_args[@]}" "${fzf_args[@]}" "${transport_args[@]}" | extract_results
    fi
}
