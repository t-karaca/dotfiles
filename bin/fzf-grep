#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)
APPEARANCE_STATE="$ROOT_DIR/../state/appearance"

RG='rg --line-number --no-heading --color=always --smart-case'

fail() {
    printf 'fzf-grep: %s\n' "$1" >&2
    exit 1
}

read_appearance() {
    [[ -f $APPEARANCE_STATE ]] || fail "appearance state is unavailable: $APPEARANCE_STATE"
    case $(<"$APPEARANCE_STATE") in
        dark)
            [[ $(wc -c <"$APPEARANCE_STATE") -eq 5 ]] || fail 'appearance state is malformed'
            appearance=dark
            ;;
        light)
            [[ $(wc -c <"$APPEARANCE_STATE") -eq 6 ]] || fail 'appearance state is malformed'
            appearance=light
            ;;
        *)
            fail 'appearance state is malformed'
            ;;
    esac
}

read_appearance

selection=$(: | fzf \
    --ansi \
    --disabled \
    --delimiter : \
    --accept-nth=1 \
    --bind "change:reload:test -n {q} && $RG {q} || true" \
    --preview "bat --paging=never --style=numbers --theme=$appearance --color=always --highlight-line {2} {1}" \
    --preview-window 'right,50%,+{2}/2'
)

if [[ -n $selection ]]; then
    cwd=$(pwd)
    source "$ROOT_DIR/fzf-navigator-tools.sh"
    printf '%s/%s\n' "${cwd%/}" "$selection"
fi
