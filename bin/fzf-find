#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)

selection=$(
    fd . | eza --stdin --oneline --icons=always --color=always --sort none --no-quotes --treat-dirs-as-files | fzf \
        --layout reverse \
        --ansi \
        --scheme path \
        --preview "fzf-navigator-tools.sh preview {}" \
        --preview-window "right" \
        --preview-border none
)

if [[ -n $selection ]]; then
    cwd=$(pwd)
    filename=''
    source "$ROOT_DIR/fzf-navigator-tools.sh"
    filename=$(extract_filename "$selection")
    printf '%s/%s\n' "${cwd%/}" "$filename"
fi
